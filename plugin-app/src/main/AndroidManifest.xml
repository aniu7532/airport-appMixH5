<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.tencent.shadow.sample.plugin">

<!--    android:theme="@style/AppTheme"-->

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.NoActionBar"
        >
        <service android:name=".MyService"/>

        <activity android:name=".MainActivity1">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".MainActivity2"/>
        <activity android:name=".MainActivity3"/>
        <activity android:name=".MainActivity4"/>
        <activity android:name=".MainActivity5"/>
        <activity android:name=".MainActivity6"/>

        <activity android:name=".TestActivityOrientationActivity"/>

        <service android:name="com.tencent.shadow.sample.plugin.HostAddPluginViewService" />

        <!--dynamic activity注册 end -->

        <!--  宿主发送过来退出登录广播 -->
        <receiver android:name="com.tencent.shadow.sample.plugin.receiver.HostLogoutReceiver">
            <intent-filter>
                <action android:name="com.host.logout" />
            </intent-filter>
        </receiver>

        <!--  宿主发送过来的扫码广播 -->
        <receiver android:name="com.tencent.shadow.sample.plugin.receiver.HostScanReceiver">
            <intent-filter>
                <action android:name="com.host.scan" />
            </intent-filter>
        </receiver>

    </application>

</manifest>