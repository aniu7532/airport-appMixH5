<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:layout_height="match_parent">

   <include layout="@layout/app_bar"/>

   <TextView
       android:id="@+id/tvGetPermissions"
       android:layout_width="match_parent"
       android:textSize="15sp"
       android:paddingVertical="12dp"
       android:layout_marginHorizontal="16dp"
       android:layout_marginTop="16dp"
       android:background="@drawable/shape_003"
       android:textColor="#333333"
       android:gravity="center"
       android:text="查询是否获取存储权限"
       android:layout_height="wrap_content"/>

   <TextView
       android:id="@+id/tvGetLocalPic"
       android:layout_width="match_parent"
       android:textSize="15sp"
       android:paddingVertical="12dp"
       android:layout_marginHorizontal="16dp"
       android:layout_marginTop="16dp"
       android:background="@drawable/shape_003"
       android:textColor="#333333"
       android:gravity="center"
       android:text="访问本地图库"
       android:layout_height="wrap_content"/>

   <TextView
       android:id="@+id/tvCheckPermissionsCamera"
       android:layout_width="match_parent"
       android:textSize="15sp"
       android:paddingVertical="12dp"
       android:layout_marginHorizontal="16dp"
       android:layout_marginTop="16dp"
       android:background="@drawable/shape_003"
       android:textColor="#333333"
       android:gravity="center"
       android:text="查询是否获得相机权限"
       android:layout_height="wrap_content"/>

   <TextView
       android:id="@+id/tvCamera"
       android:layout_width="match_parent"
       android:textSize="15sp"
       android:paddingVertical="12dp"
       android:layout_marginHorizontal="16dp"
       android:layout_marginTop="16dp"
       android:background="@drawable/shape_003"
       android:textColor="#333333"
       android:gravity="center"
       android:text="询问相机权限并启动相机拍照"
       android:layout_height="wrap_content"/>


   <ImageView
       android:id="@+id/imgShow"
       android:layout_width="200dp"
       android:layout_marginTop="16dp"
       android:adjustViewBounds="true"
       android:layout_gravity="center_horizontal"
       android:layout_height="wrap_content"/>

</LinearLayout>